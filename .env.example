# 유물 데이터
VITE_ARTIFACT_STORAGE_MODE=local
VITE_ARTIFACTS_API_PATH=/api/artifacts

# AWS EKS 연결
VITE_API_BASE_URL=https://api.vora-heritage.click

# Mock 사용 여부
VITE_USE_XRAY_MOCK=false
VITE_USE_GUIDE_MOCK=false
VITE_USE_POTTERY_MOCK=false
VITE_USE_USER_MOCK=false
VITE_USE_BOARD_MOCK=false
VITE_USE_NOTICE_MOCK=false

# X-RAY 결합: Spring 경유
VITE_XRAY_STITCH_API_BASE=https://api.vora-heritage.click/api/xray/stitch

# 결함 분석·문안 생성: Spring 경유
VITE_VIA_SPRING=true
VITE_XRAY_SPRING_INSPECTION_API_BASE=https://api.vora-heritage.click/api/xray